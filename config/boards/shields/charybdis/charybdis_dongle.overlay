/*
 * charybdis_dongle.overlay  —  USB central
 *
 * Receives PMW3610 trackball events relayed from the right peripheral on
 * channel 1, re-emits them through a virtual-input + input-listener, and
 * drives a Sinowealth SH1106 1.3" OLED (128×64) via pro_micro_i2c.
 *
 * Wiring (Nice!Nano v2 → OLED):
 * VCC → 3.3 V   GND → GND   SDA → D2 (P0.17)   SCL → D3 (P0.20)
 */

/* Pull in the shared keyboard matrix, kscan, physical layout and keymap
 * definitions — the same as charybdis_left.overlay and charybdis_right.overlay. */
#include "charybdis.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zephyr,display = &oled;
    };

    /* Clean, basic mock scanner definition */
    mock_kscan: kscan {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    trackball_central: trackball_central {
        compatible = "zmk,virtual-input";
    };

    trackball_relay_config: trackball_relay_config {
        compatible = "zmk,split-peripheral-input-relay";
        relay-channel = <1>;
        device = <&trackball_central>;
    };

    /* ── CLEAN PASS-THROUGH INPUT LISTENER ── */
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_central>;
        /* No complex processor transformations here; raw packets pass straight to USB */
    };
};

/* ── TARGET VIA PATH ADDRESS INSTEAD OF UNRESOLVED LABEL REFERENCE ── */
&spi0 {
    status = "disabled"; /* Shuts down the physical master SPI block on the dongle cleanly */
};

/* ── STRIP MATRIX REQUIREMENTS BUT KEEP NODE LOGIC FOR ORDINALS ── */
&kscan0 {
    /delete-property/ diode-direction;
    /delete-property/ row-gpios;
    /delete-property/ col-gpios;
};

/* ── SH1106 1.3" OLED on pro_micro_i2c ────────────────────────────────── */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0,17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };	
}; 

&pro_micro_i2c {
	status = "okay";
	compatible = "nordic,nrf-twi";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
	oled: sh1106@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <129>;
        height = <64>;
        segment-offset = <1>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        inversion-on;
        prechargep = <0x22>;
	};
};
